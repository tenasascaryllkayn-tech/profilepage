<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: #fcf8f5;
  font-family: 'Nunito', 'Segoe UI', Arial, sans-serif;
  max-width: 900px;
  margin: 30px auto;
  padding: 20px;
  color: #4a3f3a;
}

/* ===== HERO ===== */
.hero {
  background: #ffe4e1;
  border-radius: 50px;
  padding: 50px 30px 40px;
  text-align: center;
  margin-bottom: 30px;
}

.profile-photo {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  object-fit: cover;
  border: 5px solid white;
  box-shadow: 0 4px 20px rgba(180,140,130,0.2);
  margin-bottom: 15px;
}

.hero h1 {
  color: #d4738a;
  font-size: 3rem;
  margin: 0;
  font-weight: 700;
}

.hero .sub {
  color: #b5847a;
  font-size: 1.2rem;
  margin-top: 5px;
  font-weight: 600;
}

.hero .desc {
  color: #8a6b63;
  font-size: 0.95rem;
  margin-top: 10px;
}

.hero .desc i {
  margin: 0 5px;
  color: #d4738a;
}

/* ===== CARDS GRID ===== */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin: 25px 0;
}

.card {
  background: white;
  border-radius: 28px;
  padding: 25px 20px;
  border: 1px solid #f5ede8;
  text-align: center;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 25px rgba(180,140,130,0.12);
}

.card .icon {
  font-size: 2.6rem;
  display: block;
  margin-bottom: 8px;
  color: #d4738a;
}

.card h3 {
  color: #d4738a;
  font-size: 1.15rem;
  margin-bottom: 6px;
  font-weight: 700;
}

.card p {
  color: #5a4a44;
  font-size: 0.92rem;
  line-height: 1.5;
}

/* Pastel card variants */
.pink-card { background: #ffe8e6; border-color: #fdd5d0; }
.blue-card { background: #e6f2ff; border-color: #cce0f5; }
.peach-card { background: #ffede3; border-color: #fddbc8; }
.lavender-card { background: #f2ebff; border-color: #e0d4f5; }
.mint-card { background: #e4f5ee; border-color: #c5e8db; }
.yellow-card { background: #fff5e6; border-color: #f5e8d0; }

/* ===== SECTIONS ===== */
.section-full {
  background: white;
  border-radius: 28px;
  padding: 30px;
  margin: 25px 0;
  border: 1px solid #f5ede8;
}

.section-full h2 {
  color: #d4738a;
  font-size: 1.5rem;
  margin-bottom: 12px;
  font-weight: 700;
}

.section-full h2 i {
  margin-right: 10px;
  color: #d4738a;
}

/* ===== EXPERIENCE ===== */
.experience-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px dashed #f0e0d8;
}

.experience-item:last-child {
  border-bottom: none;
}

.experience-icon {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  flex-shrink: 0;
  color: #d4738a;
  background: white;
  border: 1px solid #f0e0d8;
}

.experience-info h4 {
  color: #4a3f3a;
  font-size: 1rem;
  font-weight: 700;
}

.experience-info .company {
  color: #d4738a;
  font-weight: 600;
  font-size: 0.92rem;
}

.experience-info .role {
  color: #8a6b63;
  font-size: 0.85rem;
}

/* ===== EDUCATION LIST ===== */
.education-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px dashed #f0e0d8;
}

.education-item:last-child {
  border-bottom: none;
}

.education-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
  color: #d4738a;
  background: white;
  border: 1px solid #f0e0d8;
}

.education-info h4 {
  color: #4a3f3a;
  font-size: 1rem;
  font-weight: 700;
}

.education-info .school {
  color: #d4738a;
  font-weight: 600;
  font-size: 0.9rem;
}

.education-info .status {
  color: #8a6b63;
  font-size: 0.85rem;
}

.education-info .status i {
  color: #4CAF50;
  margin-right: 4px;
}

/* ===== TOOLS / SKILLS ===== */
.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
  margin-top: 10px;
}

.tool-item {
  background: white;
  padding: 8px 12px;
  border-radius: 12px;
  border: 1px solid #f0e0d8;
  text-align: center;
  font-size: 0.8rem;
  color: #4a3f3a;
  font-weight: 600;
  transition: transform 0.2s;
}

.tool-item:hover {
  transform: scale(1.05);
  background: #ffe8e6;
}

.tool-item i {
  color: #d4738a;
  margin-right: 5px;
}

/* ===== PROJECTS ===== */
.project-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px dashed #f0e0d8;
}

.project-item:last-child {
  border-bottom: none;
}

.project-icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  flex-shrink: 0;
  color: #d4738a;
}

.project-info h4 {
  color: #4a3f3a;
  font-size: 1.05rem;
  font-weight: 700;
}

.project-info p {
  color: #8a6b63;
  font-size: 0.88rem;
}

/* ===== TAGS ===== */
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 15px;
}

.tag {
  background: white;
  padding: 6px 16px;
  border-radius: 50px;
  font-size: 0.82rem;
  border: 1px solid #f0d9d0;
  color: #5a4a44;
  font-weight: 600;
}

.tag i {
  margin-right: 5px;
  color: #d4738a;
}

/* ===== FOOTER ===== */
.footer {
  text-align: center;
  padding: 25px 0 10px;
  color: #bfaaa0;
  font-size: 0.9rem;
}

.footer a {
  color: #d4738a;
  text-decoration: none;
  margin: 0 12px;
  font-weight: 600;
}

.footer a:hover {
  text-decoration: underline;
}

.social-icons {
  font-size: 2rem;
  margin: 10px 0;
}

.social-icons a {
  margin: 0 12px;
  color: #d4738a;
}

.social-icons a:hover {
  color: #b5847a;
}

/* ===== MOBILE ===== */
@media (max-width: 600px) {
  .grid {
    grid-template-columns: 1fr;
  }
  .tools-grid {
    grid-template-columns: 1fr 1fr;
  }
  .hero h1 {
    font-size: 2.2rem;
  }
  .profile-photo {
    width: 100px;
    height: 100px;
  }
  .hero {
    padding: 30px 20px 25px;
  }
}
</style>
</head>
